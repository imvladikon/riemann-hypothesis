    set G : _root_.ReciprocityTheory.L2DbarEstimates.V n → ℝ≥0∞ := fun v => ENNReal.ofReal (Real.exp (-φ v) * Real.exp (-Ψ v)) with hG
    have hpt : ∀ v ∈ W, ENNReal.ofReal (‖c‖ ^ 2 * h (e.symm v) * Real.exp (-A.ph E i (e.symm v))) ≤
