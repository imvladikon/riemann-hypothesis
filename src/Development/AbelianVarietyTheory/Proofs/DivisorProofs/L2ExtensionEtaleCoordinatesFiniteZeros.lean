  have hc2 : min 1 (1 / (2 * δ ^ 2)) ≤ 1 / (2 * δ ^ 2) := min_le_right _ _
  have hcd : min 1 (1 / (2 * δ ^ 2)) * δ ^ 2 ≤ 1 / 2 := by
    calc min 1 (1 / (2 * δ ^ 2)) * δ ^ 2 ≤ 1 / (2 * δ ^ 2) * δ ^ 2 :=
          mul_le_mul_of_nonneg_right hc2 (sq_nonneg δ)
