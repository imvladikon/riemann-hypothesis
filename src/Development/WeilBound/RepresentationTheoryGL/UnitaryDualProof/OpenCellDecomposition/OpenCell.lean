def box (ι : Type) (γ : ValueGroupWithZero k) : AddSubgroup (ι → k) where
  carrier := {Y | ∀ i, valuation k (Y i) ≤ γ}
  add_mem' {a b} ha hb i := ((valuation k).map_add (a i) (b i)).trans (max_le (ha i) (hb i))
