      IsCompact ((unipU k d hd ⊓ (congruenceSubgroup k N n).comap
        (MulAut.conj (pm k (wOpen d hd))).toMonoidHom : Subgroup (GL (Fin N) k)) : Set (GL (Fin N) k)) ∧
