  have hs : ∀ a, IsSmooth (π a) := by
    intro a
    fin_cases a
    exacts [hA, hx]
  obtain ⟨E⟩ := nonempty_prod₂_equiv_multiProd (Fin.sum_univ_two d) π
  have h' : IsGenericFor ψ (multiProd (stdBlocks d (Fin.sum_univ_two d)) π) :=
