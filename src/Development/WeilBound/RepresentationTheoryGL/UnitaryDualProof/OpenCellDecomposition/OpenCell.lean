theorem expLow : PositivityTheory.RgUd.BesselSum k → PositivityTheory.RgUd.OpenCell k → PositivityTheory.RgUd.ExpLow k := by
  intro hB hO r m V W _ _ _ _ A x ω s hr hm hAs hxs hgen hunit hω hωn
