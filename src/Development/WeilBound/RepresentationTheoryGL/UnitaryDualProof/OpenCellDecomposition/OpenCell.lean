theorem nontrivial_of_piTensor {ι : Type} [Fintype ι] [DecidableEq ι] {M : ι → Type} [∀ i, AddCommGroup (M i)]
    [∀ i, Module ℂ (M i)] (h : Nontrivial (⨂[ℂ] i, M i)) (i : ι) : Nontrivial (M i) := by
