  have hc : ((rowI (r := r) i : Fin (r + m)) : ℕ) < m ∧ m ≤ ((colI (m := m) j : Fin (r + m)) : ℕ) := by
    simp [rowI, colI]
  rw [dite_eq_left hc]
  congr 2
  all_goals
    apply Fin.ext
    simp [colI]

