        have h := hgN
        simp only [mul_sub, sub_mul] at h
        rw [hgc] at h
        simpa using h
      refine Prod.ext ?_ ?_
      · show (g : Matrix (Fin n) (Fin n) k) * (rep t).1.1 * ((g⁻¹ : GL (Fin n) k) : Matrix (Fin n) (Fin n) k) = x
        rw [key, mul_assoc, Units.mul_inv, mul_one]
      · exact hgv

