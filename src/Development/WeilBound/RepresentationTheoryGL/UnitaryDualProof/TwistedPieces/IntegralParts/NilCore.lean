    (fun u => f (PositivityTheory.RgUd.TP.Nil.hom t⁻¹ (E Z u, v)) * (ψ (u ⬝ᵥ D τ Z x) : ℂ))
  rw [Tm_det] at key
  simp only [Tm_mulVec] at key
