theorem fourQ : FourQ k := by
  intro hT n Z hZ
  obtain ⟨τ, hs, hnd, hnil⟩ := hT n Z hZ
  have h : Hyp τ Z := ⟨hs, hnd, hnil⟩
  letI : MeasurableSpace k := borel k
