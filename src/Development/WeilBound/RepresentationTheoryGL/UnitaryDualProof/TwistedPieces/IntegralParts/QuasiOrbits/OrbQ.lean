    · intro y
      apply Subtype.ext
      apply Subtype.ext
      show x * ((ψ y : Cs) : Matrix (Fin n) (Fin n) k) - ((ψ y : Cs) : Matrix (Fin n) (Fin n) k) * x =
        t⁻¹ • ((ψ (δ y) : Cs) : Matrix (Fin n) (Fin n) k)
      rw [hψ, hψ, hδ]
      calc x * (g.val * y * g⁻¹.val) - g.val * y * g⁻¹.val * x
