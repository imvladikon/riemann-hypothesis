  have hu0 : 0 < valuation k (u₀ : k) := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr u₀.ne_zero)
  have h1 : 1 < (valuation k (z : k))⁻¹ := (one_lt_inv₀ (zero_lt_iff.mpr hz0)).mpr hz
