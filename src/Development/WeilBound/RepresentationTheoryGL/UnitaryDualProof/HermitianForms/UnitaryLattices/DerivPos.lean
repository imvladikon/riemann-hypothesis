    intro x hx
    have := hS hx
    simp only [Set.mem_iUnion, Set.mem_preimage, SetLike.mem_coe] at this
    obtain ⟨a, ha, hxa⟩ := this
    exact ⟨a, Finset.mem_image_of_mem _ ha, hxa⟩
